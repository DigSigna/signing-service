# Configuración Base
PROJECT_NAME=Digital Signature Microservice
VERSION=1.0.0
API_V1_STR=/api/v1

# Database (Connection String)
# - make up (docker-compose.dev.yml, requiere hsm-service corriendo): mysql://digsigna:digsigna@mysql:3306/digsigna
# - make infra-up (docker-compose.yml, standalone) + uvicorn local:    mysql://digsigna:digsigna@localhost:3306/digsigna
# Sin default funcional en config/config.yaml: si no seteás esto, el arranque falla (a propósito).
DB_URL=mysql://digsigna:digsigna@localhost:3306/digsigna

# Redis (solo necesario si AUTH_TOKEN_CACHE_ENABLED=true; no hay servicio Redis en ninguno de los dos compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HSM (vía hsm-service; este servicio nunca lo toca directamente)
HSM_LIBRARY_PATH=/usr/lib/softhsm/libsofthsm2.so
# in_memory: stub local, no requiere hsm-service (usar con docker-compose.yml / infra-up)
# remote: HSM real vía hsm-service (usar con docker-compose.dev.yml -> HSM_SERVICE_BASE_URL=http://hsm-service:8080)
HSM_BACKEND=in_memory
HSM_SERVICE_BASE_URL=http://localhost:8080
HSM_SERVICE_TIMEOUT=5s
HSM_SLOT=0
HSM_PIN=1234

# Audit
AUDIT_ENABLED=true
AUDIT_STRATEGY=hybrid
AUDIT_HTTP_BASE_URL=
AUDIT_HTTP_TIMEOUT=5s
AUDIT_HYBRID_MAX_FAILURES=3
AUDIT_HYBRID_RESET_TIMEOUT=30s

# Auth
AUTH_MODE=development
AUTH_PUBLIC_KEY_PATH=./keys/public.pem
AUTH_JWKS_URL=
AUTH_JWKS_CACHE_MINUTES=60
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_TOKEN_CACHE_ENABLED=false
AUTH_TOKEN_CACHE_STRICT=true
AUTH_TOKEN_CACHE_PREFIX=token
AUTH_TOKEN_CACHE_TIMEOUT=1s